{
  "extends": "./_base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@theme/*": ["../docs/.vitepress/theme/*"]
    },
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": [
      "vite/client",
      "vitepress/client"
    ]
  },
  "include": [
    "../docs/.vitepress/**/*",
    "../docs/.vitepress/**/*.json",
    "../docs/.vitepress/**/*.vue"
  ],
  "exclude": [
    "../docs/.vitepress/cache",
    "../docs/.vitepress/dist",
    "../node_modules"
  ]
}
