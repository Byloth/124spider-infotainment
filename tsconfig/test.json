{
  "extends": "./_base.json",
  "compilerOptions": {
    "composite": true,

    // The DOM libs are here for the *components* this project now includes, not for the tests: the
    // tests run under Node and render through `@vue/server-renderer`, which needs no DOM at all. But
    // `HashVerifier` and `HashTable` legitimately name `HTMLInputElement` and `navigator.clipboard`,
    // and a project that includes them has to be able to see those types.
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],

    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.test.tsbuildinfo",

    // `vite/client` is here for the same reason the DOM libs are: this project includes the components,
    // and one of them (`SourceCite`) reads `import.meta.env.BASE_URL` to make its link base-aware.
    "types": ["node", "vite/client"]
  },
  "include": [
    "../tests/**/*",
    "../vitest.config.ts",

    // The data modules the tests import. They also belong to `app.json`; listing them here as well is
    // what lets this project type-check the imports without a project reference (which would need
    // declaration emit, and `_base.json` sets `noEmit`).
    "../docs/.vitepress/data/**/*",
    "../docs/.vitepress/logic/**/*",

    // `tests/diagrams.test.ts` and `tests/components.test.ts` render components to check they follow
    // the data, so the whole component tree has to be visible to this project.
    "../docs/.vitepress/theme/components/**/*"
  ]
}
